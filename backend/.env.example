DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Product policy (safe baseline) ---
# `legacy_simulation` is accepted only for local tests and must never be used
# by a public deployment.
PRODUCT_MODE=non_gambling
ENABLE_FIAT_PAYMENTS=false
ENABLE_CRYPTO_CHECKOUT=false
ENABLE_PLAYER_MARKETPLACE=false
ENABLE_CREATOR_PAYOUTS=false
ENABLE_VIP_SALES=false
ENABLE_FREE_GAMEPLAY=true
ENABLE_PAID_GAMEPLAY=false
ENABLE_GAMEPLAY_TOKEN_REWARDS=false
ENABLE_JACKPOT=false
ENABLE_PURCHASED_RANDOM_REWARDS=false
ENABLE_TOKEN_CASHOUT=false
ENABLE_PLAYER_TOKEN_TRANSFERS=false
ENABLE_CLIENT_REPORTED_REWARDS=false
ENABLE_PROMOTIONAL_TOKEN_REWARDS=false
ENABLE_ADMIN_TOKEN_MINTS=false
ENABLE_ADMIN_BALANCE_ADJUSTMENTS=false
ENABLE_PASSIVE_TOKEN_REWARDS=false
ENABLE_LEGACY_ASSET_CLAIMS=false
ENABLE_FIXED_ITEM_SHOP=false
ENABLE_FIXED_GAMEPLAY_SPENDING=false
ENABLE_CARD_CRAFTING=false
ENABLE_BOARD_ASSET_MUTATIONS=false
ENABLE_HATCHING=false
ENABLE_RECICLON=false
REQUIRE_ADULT_FOR_COMMERCE=true
CHAIN_ECONOMY_AUTHORITATIVE=true

# Keep these empty until the legal entity, versioned policies and real
# providers are ready. Commerce cannot start without them.
PAYMENT_GATEWAY_PROVIDER=mock
KYC_PROVIDER=
LEGAL_ENTITY_NAME=
TERMS_VERSION=
PRIVACY_NOTICE_VERSION=

PLASMA_RPC_URL=http://localhost:8545
TREASURY_PRIVATE_KEY=0x_your_private_key_here

AXOGEMA_ADDRESS=
WEBITOS_ADDRESS=
CARDS_ADDRESS=
BOOSTERS_ADDRESS=
ANVIL_RPC_URL=http://localhost:8545
ANVIL_PID=
GEMA_ALGA_ADDRESS=
AXOLOTITOS_ADDRESS=
TABLAS_ADDRESS=
CONSUMABLES_ADDRESS=
GAME_CONTROLLER_ADDRESS=
BLOCKCHAIN_MODE=local
IS_MOCK_WEB3=false
ALLOW_DEV_PAYMENTS=false

# --- Admin Dashboard ---
ADMIN_PRIVY_DID=did:privy:your_admin_did_here
SIMULATION_REPORT_PATH=./simulation_report.txt

# --- Leonardo.ai ---
LEONARDO_API_KEY=
LEONARDO_OUTPUT_DIR=./output/cards
LEONARDO_WEBHOOK_SECRET=
